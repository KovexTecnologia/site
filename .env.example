# URL canonica de producao (sem barra no final). Usada em canonical, sitemap, OG e JSON-LD.
NEXT_PUBLIC_SITE_URL=https://kovextech.com.br

# Envio do formulario de contato (opcional).
# Sem RESEND_API_KEY o formulario continua funcionando e apenas registra o lead no log do servidor.
RESEND_API_KEY=
CONTACT_TO_EMAIL=contato@kovextech.com.br
CONTACT_FROM_EMAIL=site@kovextech.com.br

# Verificacao do Google Search Console (conteudo da meta tag google-site-verification).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
