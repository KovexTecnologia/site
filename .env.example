# URL canonica de producao (sem barra no final). Usada em canonical, sitemap, OG e JSON-LD.
NEXT_PUBLIC_SITE_URL=https://kovex.com.br

# Envio do formulario de contato (opcional).
# Sem RESEND_API_KEY o formulario continua funcionando e apenas registra a mensagem no log do servidor.
RESEND_API_KEY=
CONTACT_TO_EMAIL=contato@kovex.com.br
# Precisa ser de um dominio verificado no Resend.
CONTACT_FROM_EMAIL=site@kovex.com.br

# Verificacao do Google Search Console (conteudo da meta tag google-site-verification).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
